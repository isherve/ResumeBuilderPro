# Production — set these in Railway dashboard after deploy
NODE_ENV=production
PORT=5000
API_URL=https://YOUR-BACKEND.up.railway.app
FRONTEND_URL=https://YOUR-FRONTEND.vercel.app
DATABASE_URL=postgresql://...

JWT_SECRET=change-me-min-32-characters-long-secret
JWT_REFRESH_SECRET=change-me-min-32-characters-refresh
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://YOUR-BACKEND.up.railway.app/api/auth/google/callback
